---
import PlantImageRoles from "../../components/PlantImageRoles.astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { formatDate } from "../../lib/date";

export async function getStaticPaths() {
  const plants = await getCollection("plants");

  const orchids = plants.filter(
    (plant) => plant.data.type === "orchid" && !plant.data.draft
  );

  return orchids.map((plant) => ({
    params: {
      slug: plant.id.replace(/\.md$/, ""),
    },
    props: {
      plant,
    },
  }));
}

const { plant } = Astro.props;
const { Content } = await render(plant);
---

<Layout
  title={`${plant.data.title} | Orchid Rescue`}
  description={plant.data.description}
>
  <div class="page">
    <p><a href="/orchid-rescue/">← Orchid Rescue</a></p>

    <h1>{plant.data.title}</h1>

    <PlantImageRoles {...plant.data} />

    <dl>
      <dt>Status</dt>
      <dd>{plant.data.status}</dd>

      {plant.data.species && (
        <>
          <dt>Species</dt>
          <dd>{plant.data.species}</dd>
        </>
      )}

      {plant.data.acquired && (
        <>
          <dt>Acquired</dt>
          <dd>{formatDate(plant.data.acquired)}</dd>
        </>
      )}
    </dl>

    {plant.data.updatedDate && <p>Last updated: {formatDate(plant.data.updatedDate)}</p>}

    <article class="plant-content">
      <Content />
    </article>

  </div>
</Layout>

<style>
  .page {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    line-height: 1.6;
  }

  dt {
    font-weight: 700;
    margin-top: 1rem;
  }

  dd {
    margin: 0 0 0.75rem 0;
  }

  .plant-content {
    max-width: 800px;
    margin: 2rem auto 0;
    overflow-wrap: anywhere;
  }

  .plant-content :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 650px;
    height: auto;
    margin: 1.5rem auto;
    border-radius: 0.75rem;
    object-fit: contain;
  }

  .plant-content :global(.plant-history-notes) {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1rem;
    margin: 2rem 0;
    background: var(--color-surface);
  }
  .plant-content :global(summary) { cursor: pointer; font-weight: 700; }
  .plant-content :global(summary:focus-visible) { outline: 3px solid var(--color-link); }

</style>
