---
interface Props {
  title: string;
  originalImage?: string;
  currentImage?: string;
  heroImage?: string;
}
const { title, originalImage, currentImage, heroImage } = Astro.props;
const roles = [
  { label: "Original", image: originalImage, description: "First documented photograph", missing: "Original photo not yet designated." },
  { label: "Current", image: currentImage, description: "Latest representative photograph", missing: "Current photo not yet designated." },
  { label: "Featured", image: heroImage || currentImage || originalImage, description: heroImage ? "Selected highlight" : (currentImage || originalImage ? "Using an available photograph" : "Curated photograph"), missing: "No photograph available yet." },
];
---

<section class="plant-image-roles" aria-label={`${title} photographs`}>
  {roles.map(({ label, image, description, missing }) => (
    <figure class="plant-image-role" data-image-role={label.toLowerCase()}>
      <figcaption><strong>{label}</strong><span>{description}</span></figcaption>
      <div class="image-frame">
        {image ? <a href={image} aria-label={`View ${title} — ${label.toLowerCase()} photograph`}>
          <img src={image} alt={`${title} — ${label.toLowerCase()} photograph`} decoding="async" />
        </a> : <p class="image-missing">{missing}</p>}
      </div>
    </figure>
  ))}
</section>

<style>
  .plant-image-roles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }
  .plant-image-role {
    min-width: 0;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface);
    overflow: hidden;
  }
  figcaption { padding: 0.75rem; min-height: 6rem; box-sizing: border-box; }
  figcaption strong { display: block; font-size: 1.1rem; }
  figcaption span { display: block; font-size: 0.85rem; color: var(--color-muted); }
  .image-frame { height: 260px; }
  .image-frame a { display: block; height: 100%; }
  .image-frame a:focus-visible { outline: 3px solid var(--color-link); outline-offset: -3px; }
  img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .image-missing { display: grid; place-items: center; height: 100%; box-sizing: border-box; margin: 0; padding: 1rem; text-align: center; color: var(--color-muted); }
  @media (max-width: 700px) {
    .plant-image-roles { grid-template-columns: 1fr; }
    .image-frame { height: 280px; }
  }
</style>
